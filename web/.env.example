# Placeholder values. Copy this file to .env and fill in the real Firebase values.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: AI features (Firebase AI Logic). See docs/ai-features.md.
# Model used for the description assistant and dashboard summary.
VITE_GEMINI_MODEL=gemini-2.5-flash
# Optional: reCAPTCHA v3 site key for Firebase App Check (protects the AI quota).
VITE_APPCHECK_SITE_KEY=
