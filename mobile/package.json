{
  "name": "lala-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:search": "node tests/search.test.mjs",
    "test:details": "firebase emulators:exec --config ../firebase.auth-test.json --project demo-lala-auth --only auth,firestore \"node tests/guesthouse-details.test.mjs\"",
    "test:auth": "firebase emulators:exec --config ../firebase.auth-test.json --project demo-lala-auth --only auth,firestore \"node tests/customer-auth.test.mjs\"",
    "test:browse": "firebase emulators:exec --config ../firebase.auth-test.json --project demo-lala-auth --only auth,firestore \"node tests/guesthouses.test.mjs\"",
    "test:engagement": "firebase emulators:exec --config ../firebase.auth-test.json --project demo-lala-auth --only auth,firestore \"node tests/customer-engagement.test.mjs\"",
    "test:smart": "node tests/smart-search.test.mjs",
    "test:features": "node tests/nearby-similar-compare.test.mjs",
    "test:recent": "node tests/recently-viewed.test.mjs",
    "test:status": "node tests/listing-status.test.mjs",
    "test:theme": "node tests/theme.test.mjs"
  },
  "private": true
}
